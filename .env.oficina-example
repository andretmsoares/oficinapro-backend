# Máquina da oficina (Postgres local + túnel + backup no R2). Copie para .env.oficina (gitignored).
#   docker compose -f infra/docker/compose.oficina.yml --env-file .env.oficina up -d

# Banco local (criado na primeira subida). Use senha forte; o banco não é exposto na rede.
# Evite os caracteres $ e " na senha (o compose interpreta $).
POSTGRES_DB=oficinapro
POSTGRES_USER=oficinapro
POSTGRES_PASSWORD=troque-por-senha-forte

JWT_SECRET=gere-com-openssl-rand-base64-48
SERVER_PORT=8080

# ADMIN criado na primeira subida. Troque a senha depois do primeiro login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador

OFICINAPRO_CORS_ALLOWED_ORIGINS=https://appoficinapro.com.br,https://www.appoficinapro.com.br

# Imagem publicada e túnel Cloudflare
DOCKER_USERNAME=seu-usuario-dockerhub
IMAGE_TAG=latest
TUNNEL_TOKEN=

# Cloudflare R2: somente logos
R2_BUCKET=oficinapro
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Backup: dumps ficam na máquina e o banco é espelhado no Neon (substitui o conteúdo de lá!).
# Conexão DIRETA (sem -pooler). Deixe false até migrar os dados antigos do Neon para o local.
NEON_MIRROR_ENABLED=false
BACKUP_NEON_URL=postgresql://USUARIO:SENHA@HOST-DIRETO/BANCO?sslmode=require
# BACKUP_INTERVAL_HOURS=6
# BACKUP_PING_URL=https://hc-ping.com/<uuid>   # healthchecks.io: avisa se os backups pararem
