POSTGRES_DB=oficinapro
POSTGRES_HOST=localhost
POSTGRES_USER=oficinapro
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

SERVER_PORT=8080

# Chave de assinatura dos tokens JWT (HS256).
# Obrigatoria: a aplicacao nao sobe sem ela.
# Minimo de 32 caracteres. Gere uma aleatoria, nao reutilize este valor:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# ADMIN do SaaS criado automaticamente na primeira subida, se ainda nao existir
# nenhum ADMIN. Depois de criado, troque a senha e remova estas variaveis.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador do SaaS

# Logo da oficina nos PDFs (Google Cloud Storage). Opcional: sem bucket o upload de logo
# fica desabilitado e os PDFs usam a logo padrao do sistema.
# Credenciais: no GCP, anexe uma service account ao servico; fora dele, aponte
# GOOGLE_APPLICATION_CREDENTIALS para o JSON da chave (nunca commite esse arquivo).
GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/chave.json

# Alternativa ao GCS: Cloudflare R2 (API S3). Se R2_BUCKET estiver definido, o GCS e ignorado.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# CORS
OFICINAPRO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Perfil da aplicação. SEM valor, a aplicação sobe só com a configuração base (quieta).
#   dev  -> liga log de SQL e parâmetros (nunca use em produção: vaza hash de senha, CPF...)
#   prod -> logs enxutos, Swagger/OpenAPI desligados, health sem detalhes
# O compose.dev.yml já define "dev"; os compose de produção definem "prod".
# SPRING_PROFILES_ACTIVE=dev

# true SOMENTE quando a API não é alcançável diretamente (atrás do Cloudflare Tunnel, sem porta
# publicada). Com a API exposta, um cliente forjaria CF-Connecting-IP/X-Forwarded-For para escapar
# do limite de tentativas de login. O compose.tunnel.yml já define true.
# TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------------------------
# Só no .env de PRODUÇÃO (Neon + túnel). Exemplos sem valores reais:
#
# Conexão que VALIDA o certificado do servidor (verify-full) usando o truststore da JVM, em vez de
# sslmode=require (que só criptografa e aceitaria um servidor falso):
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DB?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
#
# Imagem publicada e token do túnel Cloudflare:
# DOCKER_USERNAME=seu-usuario-no-docker-hub
# IMAGE_TAG=sha-do-commit-publicado
# TUNNEL_TOKEN=
#
# Limites do login (padrões entre parênteses; ver LoginThrottleService):
# OFICINAPRO_LOGIN_TENTATIVAS_POR_BLOQUEIO=5     # falhas por IP+username até bloquear
# OFICINAPRO_LOGIN_MAX_TENTATIVAS_POR_IP=30      # tentativas por IP a cada 5 min

