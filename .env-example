POSTGRES_DB=oficinapro
POSTGRES_HOST=localhost
POSTGRES_USER=oficinapro
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

SERVER_PORT=8080

# Chave de assinatura dos tokens JWT (HS256).
# Obrigatoria: a aplicacao nao sobe sem ela.
# Minimo de 32 caracteres. Gere uma aleatoria, nao reutilize este valor:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# ADMIN do SaaS criado automaticamente na primeira subida, se ainda nao existir
# nenhum ADMIN. Depois de criado, troque a senha e remova estas variaveis.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador do SaaS
